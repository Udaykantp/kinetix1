{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer or admin profile with PII strictly isolated to owner or admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "gender": {
          "type": "string",
          "enum": ["", "Male", "Female", "Other"],
          "maxLength": 20
        },
        "role": {
          "type": "string",
          "enum": ["customer", "admin"]
        },
        "wishlistIds": {
          "type": "array",
          "description": "Bounded list of up to 50 saved product IDs"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "phone", "gender", "role", "wishlistIds", "createdAt", "updatedAt"]
    },
    "UserAddress": {
      "title": "UserAddress",
      "description": "Saved doorstep delivery and fitment address stored under a user profile.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "enum": ["Home", "Work", "Other"],
          "maxLength": 20
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "addressLine1": {
          "type": "string",
          "minLength": 3,
          "maxLength": 250
        },
        "addressLine2": {
          "type": "string",
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "pinCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12
        },
        "isDefault": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "label",
        "fullName",
        "phone",
        "email",
        "addressLine1",
        "addressLine2",
        "city",
        "state",
        "pinCode",
        "isDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "Customer battery order with line items, shipping details, and status timeline.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 40
        },
        "items": {
          "type": "array",
          "description": "Bounded list of 1 to 20 ordered battery items"
        },
        "subtotal": {
          "type": "number"
        },
        "tax": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "shipping": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "Order Placed",
            "Processing",
            "Quality Testing",
            "Dispatched",
            "Out for Delivery",
            "Delivered",
            "Cancelled",
            "Return Requested"
          ]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Card", "Net Banking", "Cash on Delivery"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Paid", "Pending COD", "Refunded"]
        },
        "shippingAddress": {
          "type": "object"
        },
        "trackingNumber": {
          "type": "string",
          "maxLength": 100
        },
        "carrier": {
          "type": "string",
          "maxLength": 100
        },
        "estimatedDelivery": {
          "type": "string",
          "maxLength": 80
        },
        "statusHistory": {
          "type": "array",
          "description": "Bounded status timeline up to 20 entries"
        },
        "returnReason": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "date",
        "items",
        "subtotal",
        "tax",
        "discount",
        "shipping",
        "total",
        "status",
        "paymentMethod",
        "paymentStatus",
        "shippingAddress",
        "trackingNumber",
        "carrier",
        "estimatedDelivery",
        "statusHistory",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Read-only registry of elevated administrator UIDs.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": ["uid", "email"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Public customer star rating and review for a specific battery model. Contains zero PII.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rating": {
          "type": "number",
          "description": "Integer star rating between 1 and 5 inclusive"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "comment": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500
        },
        "vehicleOrApplication": {
          "type": "string",
          "maxLength": 120
        },
        "configuredVariant": {
          "type": "string",
          "maxLength": 120
        },
        "verifiedPurchase": {
          "type": "boolean"
        },
        "helpfulUserIds": {
          "type": "array",
          "description": "Bounded list of up to 50 user UIDs who marked the review helpful"
        },
        "status": {
          "type": "string",
          "enum": ["published", "hidden"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "productId",
        "userId",
        "authorName",
        "rating",
        "title",
        "comment",
        "vehicleOrApplication",
        "configuredVariant",
        "verifiedPurchase",
        "helpfulUserIds",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile documents containing PII, strictly restricted to owner or admin."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/UserAddress" },
      "description": "Saved doorstep delivery addresses owned by the parent user profile."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "Customer orders readable and creatable by the authenticated owner, manageable by admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Server-managed administrator role lookup documents."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Customer star ratings and product reviews for specific battery models. Published reviews are publicly readable; writes require verified authentication and strict ownership."
    }
  }
}
